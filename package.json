{
  "name": "isle-of-khan",
  "version": "2.0.0",
  "private": true,
  "description": "A multiplayer pixel-art island brawler. Runs on Cloudflare Workers + Durable Objects.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "arena": "tsx scripts/arena.ts",
    "train": "tsx scripts/train.ts",
    "balance": "tsx scripts/balance.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
